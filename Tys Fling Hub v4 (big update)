local function refreshWhitelistList()
    for _, child in ipairs(WhitelistScrolling:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local isWhitelisted = whitelistedPlayers[player] == true
            
            local pRow = Instance.new("Frame")
            pRow.Size = UDim2.new(1, -8, 0, 30)
            pRow.BackgroundTransparency = 1
            pRow.ZIndex = 4
            pRow.Parent = WhitelistScrolling
            
            local pLabel = Instance.new("TextButton")
            pLabel.Size = UDim2.new(1, -78, 1, 0)
            pLabel.Position = UDim2.new(0, 0, 0, 0)
            pLabel.BackgroundColor3 = Color3.fromRGB(40, 20, 70)
            pLabel.BackgroundTransparency = 0.5
            pLabel.BorderColor3 = Color3.fromRGB(170, 60, 255)
            pLabel.BorderSizePixel = 0
            pLabel.ZIndex = 4
            pLabel.Text = "  " .. player.Name .. " (@" .. player.DisplayName .. ")"
            pLabel.Font = Enum.Font.GothamMedium
            pLabel.TextSize = 10
            pLabel.TextXAlignment = Enum.TextXAlignment.Left
            pLabel.TextColor3 = Color3.fromRGB(210, 170, 255)
            pLabel.Parent = pRow
            
            local pCorner = Instance.new("UICorner")
            pCorner.CornerRadius = UDim.new(0, 4)
            pCorner.Parent = pLabel
            
            local wlBtn = Instance.new("TextButton")
            wlBtn.Size = UDim2.new(0, 74, 1, 0)
            wlBtn.Position = UDim2.new(1, -74, 0, 0)
            wlBtn.BackgroundColor3 = isWhitelisted and Color3.fromRGB(40, 120, 50) or Color3.fromRGB(80, 20, 50)
            wlBtn.BackgroundTransparency = 0.2
            wlBtn.BorderColor3 = isWhitelisted and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 80, 120)
            wlBtn.BorderSizePixel = 1
            wlBtn.ZIndex = 5
            wlBtn.Text = isWhitelisted and "В СИСЕ" or "ДОБАВИТЬ"
            wlBtn.Font = Enum.Font.GothamBold
            wlBtn.TextSize = 8
            wlBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            wlBtn.Parent = pRow
            
            local wlCorner = Instance.new("UICorner")
            wlCorner.CornerRadius = UDim.new(0, 4)
            wlCorner.Parent = wlBtn
            
            wlBtn.MouseButton1Click:Connect(function()
                playClickSound()
                if whitelistedPlayers[player] then
                    whitelistedPlayers[player] = nil
                    sendNotification("❌ Игрок " .. player.Name .. " удален из вайтлиста")
                else
                    whitelistedPlayers[player] = true
                    sendNotification("✅ Игрок " .. player.Name .. " добавлен в вайтлист")
                end
                refreshWhitelistList()
            end)
        end
    end
end

refreshWhitelistList()
Players.PlayerAdded:Connect(refreshWhitelistList)
Players.PlayerRemoving:Connect(function(player)
    whitelistedPlayers[player] = nil
    refreshWhitelistList()
end)

