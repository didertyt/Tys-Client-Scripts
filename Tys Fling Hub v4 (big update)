local tabButtons = {}
local function switchTab(tabName: string)
    for name, page in pairs(Pages) do
        page.Visible = (name == tabName)
    end
    for name, btn in pairs(tabButtons) do
        if name == tabName then
            btn.BackgroundColor3 = Color3.fromRGB(70, 20, 130)
            btn.BackgroundTransparency = 0.1
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.BorderColor3 = Color3.fromRGB(255, 100, 255)
            btn.BorderSizePixel = 2
        else
            btn.BackgroundColor3 = Color3.fromRGB(35, 15, 60)
            btn.BackgroundTransparency = 0.5
            btn.TextColor3 = Color3.fromRGB(200, 160, 230)
            btn.BorderColor3 = Color3.new(0, 0, 0)
            btn.BorderSizePixel = 0
        end
    end
    local ruNames = {Troll = "Троллинг", Protection = "Защита", Player = "Игрок", Whitelist = "Вайтлист"}
    TitleLabel.Text = "🌪️ Tys Fling Hub  —  Вкладка: " .. (ruNames[tabName] or tabName)
end

local function createTabButton(name: string, text: string)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -12, 0, 34)
    btn.BackgroundColor3 = (name == "Troll") and Color3.fromRGB(70, 20, 130) or Color3.fromRGB(35, 15, 60)
    btn.BackgroundTransparency = (name == "Troll") and 0.1 or 0.5
    btn.BorderColor3 = Color3.fromRGB(255, 100, 255)
    btn.BorderSizePixel = (name == "Troll") and 2 or 0
    btn.ZIndex = 3
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = (name == "Troll") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 160, 230)
    btn.Parent = Sidebar
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        playClickSound()
        switchTab(name)
        local ruNames = {Troll = "Троллинг", Protection = "Защита", Player = "Игрок", Whitelist = "Вайтлист"}
        sendNotification("Вкладка: " .. (ruNames[name] or name))
    end)
    
    tabButtons[name] = btn
end

