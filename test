        local noclipConn = RunService.Stepped:Connect(function()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)

        infiniteKillConnection = RunService.RenderStepped:Connect(function()
            if not selectedFarmTarget or not selectedFarmTarget.Parent or not selectedFarmTarget.Character then
                sendNotification("⚠️ Target left the game or disappeared. Returning...")
                stopInfiniteKill()
