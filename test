local function toggleShiftlock(state: boolean)
    shiftlockEnabled = state
    playToggleSound(shiftlockEnabled)

    if shiftlockEnabled then
        ShiftlockBtn.BackgroundColor3 = Color3.fromRGB(80, 20, 120)
        ShiftlockBtn.BorderColor3 = Color3.fromRGB(255, 100, 255)
        ShiftlockIcon.ImageColor3 = Color3.fromRGB(255, 255, 255)
        sendNotification("🔒 Shiftlock Enabled")
        
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        
        shiftlockConnection = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                local cam = workspace.CurrentCamera
                local _, y = cam.CFrame:ToEulerAnglesYXZ()
                root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, y, 0)
            end
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end)
    else
        ShiftlockBtn.BackgroundColor3 = Color3.fromRGB(18, 10, 30)
        ShiftlockBtn.BorderColor3 = Color3.fromRGB(170, 60, 255)
        ShiftlockIcon.ImageColor3 = Color3.fromRGB(200, 160, 230)
        sendNotification("🔓 Shiftlock Disabled")
        
        if shiftlockConnection then
            shiftlockConnection:Disconnect()
            shiftlockConnection = nil
        end
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end

ShiftlockBtn.MouseButton1Click:Connect(function()
    toggleShiftlock(not shiftlockEnabled)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            if ShiftlockBtn.Visible then
                toggleShiftlock(not shiftlockEnabled)
            end
        elseif input.KeyCode == toggleMenuKey then
            toggleMenu()
        end
    end
end)

-- STREAMING_CHUNK:Cleanup and hub destruction logic...
local function destroyHub()
    if flyConnection then flyConnection:Disconnect() end
    if noclipConnection then noclipConnection:Disconnect() end
    if speedConnection then speedConnection:Disconnect() end
    if jumpConnection then jumpConnection:Disconnect() end
    if infJumpConnection then infJumpConnection:Disconnect() end
    if antiFlingConnection then antiFlingConnection:Disconnect() end
    if antiVoidConnection then antiVoidConnection:Disconnect() end
    if clickFlingConnection then clickFlingConnection:Disconnect() end
    if shiftlockConnection then shiftlockConnection:Disconnect() end
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default

    if FlyControlGui then FlyControlGui:Destroy() end
    if ShiftlockGui then ShiftlockGui:Destroy() end

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum.WalkSpeed = 16
            hum.UseJumpPower = true
            hum.JumpPower = 50
        end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end

    ScreenGui:Destroy()
end

