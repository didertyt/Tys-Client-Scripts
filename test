    notifText.TextSize = 11
    notifText.TextXAlignment = Enum.TextXAlignment.Left
    notifText.TextColor3 = Color3.fromRGB(230, 200, 255)
    notifText.Parent = notif

    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {BackgroundTransparency = 0.3}):Play()

    task.delay(notifDuration, function()
        if notif and notif.Parent then
            local tweenOut = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {BackgroundTransparency = 1})
            tweenOut:Play()
            tweenOut.Completed:Wait()
            notif:Destroy()
        end
    end)
end

