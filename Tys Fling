local selectedTarget = nil
local playerRowsTable = {}

local function refreshPlayerList()
    for _, child in ipairs(PlayersScrollingFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    playerRowsTable = {}
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pRow = Instance.new("Frame")
            pRow.Size = UDim2.new(1, 0, 0, 32)
            pRow.BackgroundTransparency = 1
            pRow.ZIndex = 3
            pRow.Parent = PlayersScrollingFrame
            
            local pBtn = Instance.new("TextButton")
            pBtn.Name = "PlayerRowButton"
            pBtn.Size = UDim2.new(1, 0, 1, 0)
            pBtn.BackgroundColor3 = (selectedTarget == player) and Color3.fromRGB(70, 20, 130) or Color3.fromRGB(40, 20, 70)
            pBtn.BackgroundTransparency = (selectedTarget == player) and 0.1 or 0.5
            pBtn.BorderColor3 = Color3.fromRGB(255, 100, 255)
            pBtn.BorderSizePixel = (selectedTarget == player) and 2 or 0
            pBtn.ZIndex = 3
            pBtn.Text = "   " .. player.Name .. " (@" .. player.DisplayName .. ")"
            pBtn.Font = (selectedTarget == player) and Enum.Font.GothamBold or Enum.Font.GothamMedium
            pBtn.TextSize = 11
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.TextColor3 = (selectedTarget == player) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(210, 170, 255)
            pBtn.Parent = pRow
            
            local pCorner = Instance.new("UICorner")
            pCorner.CornerRadius = UDim.new(0, 4)
            pCorner.Parent = pBtn
            
            playerRowsTable[player] = pBtn
            
            pBtn.MouseButton1Click:Connect(function()
                playClickSound()
                selectedTarget = player
                TitleLabel.Text = "🌪️ Tys Fling Hub  —  Target: " .. player.Name
                for plr, btn in pairs(playerRowsTable) do
                    if plr == selectedTarget then
                        btn.BorderSizePixel = 2
                        btn.BackgroundColor3 = Color3.fromRGB(70, 20, 130)
                        btn.BackgroundTransparency = 0.1
                        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        btn.Font = Enum.Font.GothamBold
                    else
                        btn.BorderSizePixel = 0
                        btn.BackgroundColor3 = Color3.fromRGB(40, 20, 70)
                        btn.BackgroundTransparency = 0.5
                        btn.TextColor3 = Color3.fromRGB(210, 170, 255)
                        btn.Font = Enum.Font.GothamMedium
                    end
                end
                sendNotification("Target set: " .. player.Name)
            end)
        end
    end
end

refreshPlayerList()
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)

-- Кнопка запуска флинга
local FlingActionBtn = Instance.new("TextButton")
FlingActionBtn.Size = UDim2.new(1, -20, 0, 40)
FlingActionBtn.Position = UDim2.new(0, 10, 1, -45)
FlingActionBtn.BackgroundColor3 = Color3.fromRGB(80, 20, 120)
FlingActionBtn.BackgroundTransparency = 0.2
FlingActionBtn.BorderColor3 = Color3.fromRGB(200, 100, 255)
FlingActionBtn.BorderSizePixel = 1
FlingActionBtn.ZIndex = 2
FlingActionBtn.Text = "🔥 START FLING TARGET 🔥"
FlingActionBtn.Font = Enum.Font.GothamBold
FlingActionBtn.TextSize = 12
FlingActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FlingActionBtn.Parent = MainFrame

local FlingBtnCorner = Instance.new("UICorner")
FlingBtnCorner.CornerRadius = UDim.new(0, 6)
FlingBtnCorner.Parent = FlingActionBtn

FlingActionBtn.MouseButton1Click:Connect(function()
    if not selectedTarget then
        sendNotification("⚠️ Select target from the list first!")
        return
    end
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum then
        sendNotification("⚠️ Your character is not loaded!")
        return
    end
    
    -- Сохраняем исходную позицию при активации команды
    local startCFrame = root.CFrame
    sendNotification("🌪️ Flinging " .. selectedTarget.Name .. " (return in 10s)...")
    playToggleSound(true)
    
    task.spawn(function()
        local target = selectedTarget
        local startTime = tick()
        
        -- Включаем noclip на время флинга
        local noclipConn
        noclipConn = RunService.Stepped:Connect(function()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
        
        while tick() - startTime < 10 do
            if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then break end
            local targetRoot = target.Character.HumanoidRootPart
            
            local angle = (tick() * 50) % (math.pi * 2) -- Исправлено: добавлен вызов функции tick()
            local offset = Vector3.new(math.cos(angle) * 3, 0, math.sin(angle) * 3)
            root.CFrame = targetRoot.CFrame + offset
            root.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
            root.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
            
            task.wait()
        end
        
        if noclipConn then noclipConn:Disconnect() end
        
        -- Возвращаем на исходную позицию с полным гашением скорости
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        root.CFrame = startCFrame
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        
        sendNotification("✅ Returned to start position with zero velocity!")
    end)
end)
