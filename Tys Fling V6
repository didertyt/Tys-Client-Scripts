KillActionBtn.MouseButton1Click:Connect(function()
    if not selectedFarmTarget then
        sendNotification("⚠️ Сначала выберите цель из списка!")
        return
    end

    infiniteKillEnabled = not infiniteKillEnabled
    playToggleSound(infiniteKillEnabled)

    if infiniteKillEnabled then
        KillActionBtn.Text = "⚔️ КИЛЛ ЦЕЛИ: ВКЛ"
        KillActionBtn.BackgroundColor3 = Color3.fromRGB(80, 20, 120)
        KillActionBtn.BorderColor3 = Color3.fromRGB(255, 100, 255)
        sendNotification("⚔️ килл запущен!")

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then
            sendNotification("⚠️ Ваш персонаж не загружен!")
            stopInfiniteKill()
            KillActionBtn.Text = "⚔️ КИЛЛ ЦЕЛИ: ВЫКЛ"
            KillActionBtn.BackgroundColor3 = Color3.fromRGB(150, 20, 60)
            return
        end

        local originalCFrame = root.CFrame

        -- Включаем ноклип на время фарма
        local noclipConn = RunService.Stepped:Connect(function()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)

        -- Постоянное удержание возле цели (телепортация)
        infiniteKillConnection = RunService.RenderStepped:Connect(function()
            if not selectedFarmTarget or not selectedFarmTarget.Parent or not selectedFarmTarget.Character then
                sendNotification("⚠️ Цель вышла из игры или пропала. Возврат...")
                stopInfiniteKill()
                noclipConn:Disconnect()
                
                if char and root and hum and hum.Health > 0 then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.CFrame = originalCFrame
                end
                
                KillActionBtn.Text = "⚔️ КИЛЛ ЦЕЛИ: ВЫКЛ"
                KillActionBtn.BackgroundColor3 = Color3.fromRGB(150, 20, 60)
                return
            end

            local targetChar = selectedFarmTarget.Character
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

            if targetRoot and targetHum and targetHum.Health > 0 then
                root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 2)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end)

        -- Фоновый поток для симуляции ударов (кликанье оружием в руке без блокировки курсора)
        attackLoopTask = task.spawn(function()
            while infiniteKillEnabled do
                local currentCharacter = LocalPlayer.Character
                if currentCharacter then
                    local tool = currentCharacter:FindFirstChildOfClass("Tool")
                    if tool then
                        pcall(function()
                            tool:Activate() -- Бьет текущим оружием в руках как при клике
                        end)
                    end
                end
                task.wait(0.2) -- Задержка между ударами (можно уменьшить или увеличить)
            end
        end)

    else
        -- Ручное выключение функции
        stopInfiniteKill()
        sendNotification("🛑Килл выключен. Возврат на точку.")
        
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if char and root and hum and hum.Health > 0 then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end

        KillActionBtn.Text = "⚔️ КИЛЛ ЦЕЛИ: ВЫКЛ"
        KillActionBtn.BackgroundColor3 = Color3.fromRGB(150, 20, 60)
    end
end)
