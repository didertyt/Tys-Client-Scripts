-- STREAMING_CHUNK:Defining sound functions...
local soundsEnabled = true

local function playSound(soundId: string, volume: number?, pitch: number?)
if not soundsEnabled then return end
task.spawn(function()
local success, err = pcall(function()
local sound = Instance.new("Sound")
sound.SoundId = soundId
sound.Volume = volume or 0.3
sound.PlaybackSpeed = pitch or 1.0
sound.Parent = SoundService
sound:Play()
sound.Ended:Connect(function()
sound:Destroy()
end)
end)
end)
end

local function playClickSound()
playSound("rbxassetid://9114221317", 0.25, 1.2)
end

local function playToggleSound(state: boolean)
playSound("rbxassetid://9114221317", 0.3, state and 1.6 or 0.7)
end

