-- Логика бесконечного килла с авто-ударом инструмента и свободной мышкой
local infiniteKillEnabled = false
local infiniteKillConnection = nil
local attackLoopTask = nil

local function stopInfiniteKill()
    if infiniteKillConnection then
        infiniteKillConnection:Disconnect()
        infiniteKillConnection = nil
    end
    if attackLoopTask then
        task.cancel(attackLoopTask)
        attackLoopTask = nil
    end
    infiniteKillEnabled = false
end

local KillActionBtn = Instance.new("TextButton")
KillActionBtn.Size = UDim2.new(1, -8, 0, 38)
